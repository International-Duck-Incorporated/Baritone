diff --git a/src/test/java/baritone/utils/EatPolicyTest.java b/src/test/java/baritone/utils/EatPolicyTest.java
new file mode 100644
index 00000000..4ca94c9c
--- /dev/null
+++ b/src/test/java/baritone/utils/EatPolicyTest.java
@@ -0,0 +1,111 @@
+/*
