diff --git a/scripts/headless/scenes.sh b/scripts/headless/scenes.sh
new file mode 100755
index 00000000..b4238c28
--- /dev/null
+++ b/scripts/headless/scenes.sh
@@ -0,0 +1,116 @@
+#!/bin/bash
+# Real-game scenes for what the unit tests cannot run: climbing, bridging, parkour, mining, the farm, exploring.
+# Each scene teleports to a spot of its own on the superflat world, builds what it needs with /fill, runs one Baritone
+# command, and asserts what the game reports - arrival is a /execute ... run say token, a count is the number /fill
+# prints for the blocks it replaced - and that the log holds no exception thrown from the tick.
+#
+# Run it against a client that is already up (run.sh in the background) with a world made by drive.sh newworld.
+# usage: scenes.sh [stairs] [bridge] [parkour] [mine] [farm] [explore]      (default: all of them, about 7 minutes)
+# exit: the number of scenes that failed
+# environment: BARITONE_HEADLESS (default ~/baritone-headless), HEADLESS_DISPLAY (:99)
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+MC_DIR="${BARITONE_HEADLESS:-$HOME/baritone-headless}"
+LOG="$MC_DIR/client.log"
+D="$HERE/drive.sh"
+pass=0
+fail=0
+
+lines() { wc -l < "$LOG"; }
+since() { tail -n +$(( $1 + 1 )) "$LOG"; }
+tick_exceptions() { since "$1" | grep -c -E 'Unreported exception thrown|Game crashed' || true; }
+# the last "Successfully filled N" (N) or "No blocks were filled" (0) after line $1
+filled() { since "$1" | grep -E 'CHAT.*(Successfully filled [0-9]+|No blocks were filled)' | tail -1 | sed -E 's/.*Successfully filled ([0-9]+).*/\1/; s/.*No blocks were filled.*/0/'; }
+arrived() { # X Y Z MARK: was the player within 2.5 blocks of the block, according to the game
+    local token="ARR$RANDOM$RANDOM"
+    "$D" chat "/execute positioned $1 $2 $3 if entity @s[distance=..2.5] run say $token"
+    sleep 2.5
+    since "$4" | grep -q "\[${HEADLESS_USER:-Headless}\] $token"   # as say output, never as the typed command
+}
+go() { "$D" chat "/tp @s $1 -60 $2"; sleep 5; } # to a scene's start, and let the chunks around it come in
+report() { # NAME OK DETAIL
+    if [ "$2" = 1 ]; then echo "PASS  $1 - $3"; pass=$((pass + 1)); else echo "FAIL  $1 - $3"; fail=$((fail + 1)); fi
+}
+
+scene_stairs() { # a two-high bump, wide enough that climbing is cheaper than going round it
+    go 0 0; local m; m=$(lines)
+    "$D" chat '/fill 4 -60 -12 4 -60 12 minecraft:stone'
+    "$D" chat '/fill 5 -60 -12 7 -59 12 minecraft:stone'
+    "$D" chat '/fill 8 -60 -12 8 -60 12 minecraft:stone'
+    "$D" chat '#goto 12 -60 0'; sleep 25
+    local ok=1 x; arrived 12 -60 0 "$m" || ok=0; x=$(tick_exceptions "$m"); [ "$x" = 0 ] || ok=0
+    report stairs "$ok" "up two, along, down two; tick exceptions $x"
+}
+
+scene_bridge() { # a trench four wide and three deep, the whole length of what is loaded: it has to be bridged
+    go 12 60; local m; m=$(lines)
+    "$D" chat '/fill 14 -63 36 17 -61 84 minecraft:air'
+    "$D" chat '/give @s minecraft:stone 64'
+    "$D" chat '#goto 22 -60 60'; sleep 55
+    local ok=1 x; arrived 22 -60 60 "$m" || ok=0; x=$(tick_exceptions "$m"); [ "$x" = 0 ] || ok=0
+    report bridge "$ok" "across a 4-wide trench; tick exceptions $x"
+}
+
+scene_parkour() { # a trench three wide, with parkour allowed
+    go 24 120; local m; m=$(lines)
+    "$D" chat '/fill 26 -63 96 28 -61 144 minecraft:air'
+    "$D" chat '#set allowParkour true'
+    "$D" chat '#goto 33 -60 120'; sleep 40
+    local ok=1 x; arrived 33 -60 120 "$m" || ok=0; x=$(tick_exceptions "$m"); [ "$x" = 0 ] || ok=0
+    "$D" chat '#set allowParkour false'
+    report parkour "$ok" "across a 3-wide trench; tick exceptions $x"
+}
+
+scene_mine() { # six of twenty-seven
+    go 33 180; local m; m=$(lines)
+    "$D" chat '/give @s minecraft:iron_pickaxe'
+    "$D" chat '/clear @s minecraft:raw_iron' # a mined six from an earlier run would end #mine 6 before it began
+    "$D" chat '/fill 38 -60 179 40 -58 181 minecraft:iron_ore'
+    "$D" chat '#mine 6 iron_ore'; sleep 55
+    "$D" chat '#stop'; sleep 2
+    local after; after=$(lines)
+    "$D" chat '/fill 38 -60 179 40 -58 181 minecraft:air replace minecraft:iron_ore'; sleep 2.5
+    local left x ok=1; left=$(filled "$after"); x=$(tick_exceptions "$m")
+    since "$m" | grep -q 'Have 6 valid items' || ok=0
+    { [ -n "$left" ] && [ "$left" -le 21 ] && [ "$left" -ge 18 ]; } || ok=0
+    [ "$x" = 0 ] || ok=0
+    report mine "$ok" "27 ore built, ${left:-?} left standing, baritone said 'Have 6 valid items': $(since "$m" | grep -c 'Have 6 valid items'); tick exceptions $x"
+}
+
+scene_farm() { # twenty-four ripe wheat round a water source: all harvested, and replanted
+    go 38 244; local m; m=$(lines) # inside the range of #farm 16 from the far corner: the range is from where it is told
+    "$D" chat '/fill 40 -61 248 44 -61 252 minecraft:farmland'
+    "$D" chat '/setblock 42 -61 250 minecraft:water'
+    "$D" chat '/fill 40 -60 248 44 -60 252 minecraft:wheat[age=7]'
+    "$D" chat '/give @s minecraft:wheat_seeds 64'
+    "$D" chat '#farm 16'; sleep 70
+    "$D" chat '#stop'; sleep 2
+    local a b; a=$(lines)
+    "$D" chat '/fill 40 -60 248 44 -60 252 minecraft:air replace minecraft:wheat[age=7]'; sleep 2.5
+    local ripe; ripe=$(filled "$a"); b=$(lines)
+    "$D" chat '/fill 40 -60 248 44 -60 252 minecraft:air replace minecraft:wheat'; sleep 2.5
+    local planted x ok=1; planted=$(filled "$b"); x=$(tick_exceptions "$m")
+    [ "${ripe:-1}" = 0 ] || ok=0
+    { [ -n "$planted" ] && [ "$planted" -ge 15 ]; } || ok=0
+    [ "$x" = 0 ] || ok=0
+    report farm "$ok" "ripe wheat left standing ${ripe:-?} (24 before), replanted ${planted:-?}; tick exceptions $x"
+}
+
+scene_explore() { # twenty seconds of #explore
+    go 33 300; local m; m=$(lines)
+    "$D" chat '#explore'; sleep 25
+    "$D" chat '#stop'; sleep 2
+    local x ok=1; x=$(tick_exceptions "$m"); [ "$x" = 0 ] || ok=0
+    report explore "$ok" "twenty-five seconds; tick exceptions $x"
+}
+
+"$D" wait-login
+sleep 3
+scenes=("$@")
+[ ${#scenes[@]} -gt 0 ] || scenes=(stairs bridge parkour mine farm explore)
+for s in "${scenes[@]}"; do
+    "$D" chat '#stop'; sleep 1
+    "scene_$s"
+done
+echo "scenes: $pass passed, $fail failed"
+exit "$fail"
diff --git a/scripts/headless/trace.py b/scripts/headless/trace.py
new file mode 100755
index 00000000..fdf9f24b
--- /dev/null
+++ b/scripts/headless/trace.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Reads the per-tick trace out of the client log and says what the player did.
+
+The trace is a datapack that drive.sh trace on writes into the world: a tick function that tells the player,
+once a game tick, "tick|[x, y, z]|[yaw, pitch]" (it is tellraw and not data get, because the output of a tick
+function is suppressed). The lines land in the log as [CHAT] lines.
+
+usage: trace.py LOG [FROM_LINE [TO_LINE]] [--csv]
+  FROM_LINE, TO_LINE   log line numbers (wc -l on the log before and after the thing you want to see)
+  --csv                one row per sample - tick,x,y,z,yaw,pitch - instead of the summary
+
+Read the numbers with one thing in mind. The positions are what the server was told, and a client that runs below
+20 frames a second (this one, on software rendering) runs its 20 ticks a second in bursts: two movement packets
+reach the server in one tick and none in the next. A per-tick speed therefore reads 0.56, 0.28, 0.00 for a walk
+at 0.28 blocks a tick. Everything here that depends on speed is taken over windows of four ticks; yaw and pitch
+are read as they are, since a rotation does not double.
+"""
+import math
+import re
+import statistics
+import sys
+
+SAMPLE = re.compile(r'\[CHAT\] (\d+)\|\[([-\d.eE]+)d, ([-\d.eE]+)d, ([-\d.eE]+)d\]\|\[([-\d.eE]+)f, ([-\d.eE]+)f\]')
+WINDOW = 6
+
+
+def read(path, start, stop):
+    rows = []
+    with open(path, errors='replace') as f:
+        for i, line in enumerate(f):
+            if i < start or (stop is not None and i >= stop):
+                continue
+            m = SAMPLE.search(line)
+            if m:
+                rows.append((int(m.group(1)),) + tuple(float(g) for g in m.groups()[1:]))
+    return rows
+
+
+def wrap(angle):
+    return (angle + 180.0) % 360.0 - 180.0
+
+
+def summary(rows):
+    if len(rows) < 3 * WINDOW:
+        sys.exit('trace.py: %d samples is too few to say anything' % len(rows))
+    print('samples %d, ticks %d to %d' % (len(rows), rows[0][0], rows[-1][0]))
+    # speed over WINDOW ticks, in blocks a tick, at the end of each window
+    speed = [0.0] * len(rows)
+    for i in range(WINDOW, len(rows)):
+        a, b = rows[i - WINDOW], rows[i]
+        ticks = max(1, b[0] - a[0])
+        speed[i] = math.hypot(b[1] - a[1], b[3] - a[3]) / ticks
+    top = max(speed)
+    if top < 0.02:
+        print('the player did not move; yaw %.1f..%.1f, pitch %.1f..%.1f'
+              % (min(r[4] for r in rows), max(r[4] for r in rows), min(r[5] for r in rows), max(r[5] for r in rows)))
+        return
+    moving = [i for i, v in enumerate(speed) if v > 0.02]
+    first, last = moving[0], moving[-1]
+    # the middle half of the walk is where the speed is steady; the fastest window is inflated by bursts
+    middle = speed[first + (last - first) // 4: last - (last - first) // 4] or speed[first:last + 1]
+    cruise = statistics.median(middle)
+    along = sum(math.hypot(b[1] - a[1], b[3] - a[3]) for a, b in zip(rows[first - WINDOW:last], rows[first - WINDOW + 1:last + 1]))
+    seconds = (rows[last][0] - rows[max(0, first - WINDOW)][0]) / 20.0
+    print('moving for about %d ticks (%.1f s); %.1f blocks covered, %.2f blocks/s on average'
+          % (last - first, (last - first) / 20.0, along, along / seconds if seconds else 0))
+    print('cruise (median over the middle of the walk) %.3f blocks/tick = %.2f blocks/s; the fastest window %.3f is inflated by bursts'
+          % (cruise, cruise * 20, top))
+    ramp = next(i for i in range(first, len(speed)) if speed[i] >= 0.9 * cruise) - first
+    print('ticks from the first motion to 90%% of cruise: %d (%d-tick windows: a resolution of %d)' % (ramp, WINDOW, WINDOW))
+    tail = [i for i in range(last, first, -1) if speed[i] >= 0.9 * cruise]
+    print('ticks from the last 90%% of cruise to the stop: %d' % (last - (tail[0] if tail else last)))
+    ys = [r[4] for r in rows[first:last + 1]]
+    ps = [r[5] for r in rows[first:last + 1]]
+    dy = [abs(wrap(rows[i][4] - rows[i - WINDOW][4])) for i in range(first, last + 1) if i >= WINDOW]
+    dp = [abs(rows[i][5] - rows[i - WINDOW][5]) for i in range(first, last + 1) if i >= WINDOW]
+    print('yaw   while moving: %.1f to %.1f (range %.1f), fastest turn %.1f degrees in %d ticks'
+          % (min(ys), max(ys), max(ys) - min(ys), max(dy or [0]), WINDOW))
+    print('pitch while moving: %.2f to %.2f (range %.2f), fastest change %.2f degrees in %d ticks, %d distinct values'
+          % (min(ps), max(ps), max(ps) - min(ps), max(dp or [0]), WINDOW, len(set(round(p, 3) for p in ps))))
+    print('pitch while moving: median %.1f, mean %.1f; %.0f%% of the samples more than 15 degrees down (positive is down)'
+          % (statistics.median(ps), statistics.fmean(ps), 100.0 * sum(1 for p in ps if p > 15.0) / len(ps)))
+    print('at rest before: yaw %.1f pitch %.1f; at rest after: yaw %.1f pitch %.1f'
+          % (rows[0][4], rows[0][5], rows[-1][4], rows[-1][5]))
+
+
+def main(argv):
+    args = [a for a in argv if not a.startswith('--')]
+    if not args:
+        sys.exit(__doc__)
+    path = args[0]
+    start = int(args[1]) if len(args) > 1 else 0
+    stop = int(args[2]) if len(args) > 2 else None
+    rows = read(path, start, stop)
+    if '--csv' in argv:
+        print('tick,x,y,z,yaw,pitch')
+        for r in rows:
+            print('%d,%.4f,%.4f,%.4f,%.3f,%.3f' % r)
+    else:
+        summary(rows)
+
+
+if __name__ == '__main__':
+    main(sys.argv[1:])
-- 
2.47.3

